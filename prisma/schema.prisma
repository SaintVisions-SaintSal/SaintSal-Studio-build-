// SaintSal™ Database Schema
// Build 308 - Production Ready

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// AUTH & USERS
// ===========================================

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  emailVerified         DateTime?
  name                  String?
  image                 String?
  hashedPassword        String?
  
  // Subscription
  tierId                String    @default("free")
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  subscriptionStatus    String    @default("inactive")
  
  // GHL Integration
  ghlLocationId         String?
  ghlApiKey             String?
  ghlRefreshToken       String?
  
  // Timestamps
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  accounts              Account[]
  sessions              Session[]
  conversations         Conversation[]
  agents                Agent[]
  leads                 Lead[]
  loanRequests          LoanRequest[]
  usageRecords          UsageRecord[]
  extensionLicenses     ExtensionLicense[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ===========================================
// CONVERSATIONS & MESSAGES
// ===========================================

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String
  context   String    @default("chat")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  role            String       // 'user' | 'assistant' | 'system'
  content         String       @db.Text
  model           String?
  tokens          Int?
  cost            Float?
  context         String?
  metadata        Json?
  createdAt       DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

// ===========================================
// AGENTS
// ===========================================

model Agent {
  id            String   @id @default(cuid())
  userId        String
  name          String
  description   String?
  systemPrompt  String   @db.Text
  model         String   @default("claude-sonnet-4-20250514")
  temperature   Float    @default(0.7)
  maxTokens     Int      @default(4096)
  tools         String[] @default([])
  isVoiceEnabled Boolean @default(false)
  voiceId       String?
  voiceSettings Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("agents")
}

// ===========================================
// LEADS
// ===========================================

model Lead {
  id          String   @id @default(cuid())
  userId      String
  firstName   String
  lastName    String
  email       String?
  phone       String?
  company     String?
  title       String?
  source      String   // 'extension' | 'apollo' | 'property_radar' | 'manual' | 'api'
  status      String   @default("new") // 'new' | 'contacted' | 'qualified' | 'proposal' | 'won' | 'lost'
  score       Int      @default(0)
  notes       String?  @db.Text
  tags        String[] @default([])
  crmId       String?
  crmType     String?  // 'ghl' | 'hubspot' | 'salesforce' | 'pipedrive'
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@map("leads")
}

// ===========================================
// LOANS
// ===========================================

model LoanRequest {
  id              String   @id @default(cuid())
  userId          String
  propertyAddress String?
  loanType        String   // 'fix_and_flip' | 'dscr' | 'bridge' | 'construction' | 'conventional'
  loanAmount      Float
  propertyValue   Float
  ltv             Float
  creditScore     Int?
  experience      String?
  timeline        String?
  status          String   @default("draft") // 'draft' | 'submitted' | 'reviewing' | 'approved' | 'funded' | 'declined'
  matchedLenders  Json?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("loan_requests")
}

// ===========================================
// USAGE & BILLING
// ===========================================

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  type      String   // 'chat' | 'research' | 'property' | 'lead' | 'loan' | 'agent' | 'api'
  count     Int      @default(1)
  model     String?
  tokens    Int?
  cost      Float?
  context   String?
  metadata  Json?
  date      DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, type, date])
  @@map("usage_records")
}

// ===========================================
// EXTENSION LICENSES
// ===========================================

model ExtensionLicense {
  id          String   @id @default(cuid())
  userId      String
  licenseKey  String   @unique
  tier        String   // 'lite' | 'pro'
  status      String   @default("active") // 'active' | 'inactive' | 'expired'
  activatedAt DateTime @default(now())
  expiresAt   DateTime
  metadata    Json?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([licenseKey])
  @@map("extension_licenses")
}

// ===========================================
// WEBHOOKS & INTEGRATIONS
// ===========================================

model WebhookEvent {
  id          String   @id @default(cuid())
  source      String   // 'stripe' | 'ghl' | 'hubspot'
  eventType   String
  payload     Json
  processed   Boolean  @default(false)
  error       String?
  createdAt   DateTime @default(now())
  processedAt DateTime?

  @@index([source, eventType])
  @@map("webhook_events")
}
